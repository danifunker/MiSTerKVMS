<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac App Store build is sandboxed (apple/AppStore/README.md). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Capture servers and mrext (outgoing only). Finding capture servers
	     goes through the system's Bonjour (StreamFinder.swift), so no
	     network.server: App Review rejects it for apps that don't listen. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- A capture card on this Mac: its video and its audio input. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Screenshots and recordings go only where the user picks in the
	     standard Save / Open panel (SessionController.swift); no standing
	     access to Movies or Pictures. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
