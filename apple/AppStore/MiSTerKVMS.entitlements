<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac App Store build is sandboxed (apple/AppStore/README.md). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Capture servers and mrext (outgoing only). Finding capture servers
	     goes through the system's Bonjour (StreamFinder.swift), so no
	     network.server: App Review rejects it for apps that don't listen. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- A capture card on this Mac: its video and its audio input. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Recordings go to Movies/MiSTerKVMS. -->
	<key>com.apple.security.assets.movies.read-write</key>
	<true/>
	<!-- Saved screenshots go to Pictures/MiSTerKVMS. -->
	<key>com.apple.security.assets.pictures.read-write</key>
	<true/>
</dict>
</plist>
